FROM alpine:3.22 AS builder

COPY ./scripts/packages/podman-setup.sh /app/scripts/podman-setup.sh

WORKDIR /app
# STEP 1
RUN <<EOF
apk upgrade && apk update && \
    apk add podman conmon runc crun

# (
# cat <<HMM
# http://dl-cdn.alpinelinux.org/alpine/edge/main
# http://dl-cdn.alpinelinux.org/alpine/edge/community
# http://dl-cdn.alpinelinux.org/alpine/edge/testing
# HMM
# ) > /etc/apk/repositories
#
# apk upgrade && apk update && \
#     apk add podman crun


if ! MODE="podman-tarball" . /app/scripts/packages/podman-setup.sh; then
    printf "\n|> Error: could not execute the podman-tarball function from the podman-setup.sh shellscript. Exiting now...\n\n"
    return 1
fi
printf "\n|> Succesfully run podman-tarball from podman-setup.sh. Proceeding..."


## if ! MODE="podman-so" . /app/scripts/podman-setup.sh; then
##     printf "\n|> Error: could not execute the podman-so function from the podman-setup.sh shellscript. Exiting now...\n\n"
##     return 1
## fi
## printf "\n|> Succesfully run podman-so from podman-setup.sh. Proceeding..."

EOF

# set podman binaries
## RUN <<EOF
