FROM alpine:3.22 AS relay

ARG PODMAN_SO_DIR="/app/podman-shared-deps/"
ARG PODMAN_BIN_DIR="/app/podman/usr/bin/"

ENV PODMAN_SO_DIR="/app/podman-shared-deps/"
ENV PODMAN_BIN_DIR="/app/podman/usr/bin/"

WORKDIR /app/
RUN <<EOF
mkdir -p "${PODMAN_SO_DIR}"
mkdir -p "${PODMAN_BIN_DIR}"
EOF


# copy podman shared objects
COPY --from=builder "/podman-so-pkg.tar.gz" /app

# copy podman  binaries
COPY --from=builder "/podman-bin-pkg.tar.gz" /app

RUN <<EOF

ls -allhtr /app

#ls -allhtr "${PODMAN_SO_DIR}"
#ls -allhtr "${PODMAN_BIN_DIR}"
EOF


ENTRYPOINT ["/bin/sh"]
