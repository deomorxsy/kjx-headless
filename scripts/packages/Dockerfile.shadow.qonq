#!/bin/sh
FROM alpine:3.22 as builder

COPY ./scripts/packages/shadow.sh /app/scripts/shadow-setup.sh

WORKDIR /app
# STEP 1
RUN <<EOF
apk upgrade && apk update && \
#    apk add shadow

(
cat <<HMM
http://dl-cdn.alpinelinux.org/alpine/edge/main
http://dl-cdn.alpinelinux.org/alpine/edge/community
http://dl-cdn.alpinelinux.org/alpine/edge/testing
HMM
) > /etc/apk/repositories

apk upgrade && apk update && \
    apk add busybox-binsh libbsd musl linux-pam shadow doas


if ! MODE="shadow-so" . /app/scripts/shadow-setup.sh; then
    printf "\n|> Error: could not execute the shadow-so function from the shadow-setup.sh shellscript. Exiting now...\n\n"
    return 1
fi
printf "\n|> Succesfully run shadow-so from shadow-setup.sh. Proceeding..."

EOF

# set shadow binaries
RUN <<EOF

if ! MODE="shadow-bin" . /app/scripts/shadow-setup.sh; then
    printf "\n|> Error: could not execute the shadow-bin function from the shadow-setup.sh shellscript. Exiting now...\n\n"
    return 1
fi
printf "\n|> Succesfully run shadow-bin from shadow-setup.sh. Proceeding..."

EOF


FROM alpine:3.22 as relay

ARG SHADOW_SO_DIR="/app/shadow-shared-deps/"
ARG SHADOW_BIN_DIR="/app/shadow/usr/bin/"

ENV SHADOW_SO_DIR="/app/shadow-shared-deps/"
ENV SHADOW_BIN_DIR="/app/shadow/usr/bin/"

WORKDIR /app/
RUN <<EOF
mkdir -p "${SHADOW_SO_DIR}"
mkdir -p "${SHADOW_BIN_DIR}"
EOF


# copy shadow shared objects
COPY --from=builder "/shadow-so-pkg.tar.gz" /app

# copy shadow binaries
COPY --from=builder "/shadow-bin-pkg.tar.gz" /app

RUN <<EOF

ls -allhtr /app

#ls -allhtr "${SHADOW_SO_DIR}"
#ls -allhtr "${SHADOW_BIN_DIR}"
EOF


ENTRYPOINT ["/bin/sh"]
