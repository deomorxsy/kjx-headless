FROM alpine:3.22 AS builder

COPY ./scripts/packages/neovim-setup.sh /app/scripts/neovim-setup.sh
COPY ./scripts/packages/demo-replased.sh /app/scripts/packages/demo-replased.sh

WORKDIR /app

# STEP 1
RUN <<EOF

TARGET_SCRIPT_PATH="./scripts/neovim-setup.sh"

build_routine() {
    if ! ( MODE="build" . "${TARGET_SCRIPT_PATH}" ); then
    echo "|> [ERROR]: could not run the [build] function of the [TARGET_SCRIPT_PATH]. Exiting now..."
    return 1

    fi
    echo "|> [PASS]: successfully ran the [build] function of the [TARGET_SCRIPT_PATH]. Proceeding..."
}
build_routine

RUN <<EOF

if ! (MODE="neovim-tarball" . /app/scripts/neovim-setup.sh); then
    printf "\n|> Error: could not execute the [neovim-tarball] function from the neovim-setup.sh shellscript. Exiting now...\n\n"
    return 1
fi
printf "\n|> Succesfully run [neovim-tarball] from neovim-setup.sh. Proceeding..."

if ! (ls -allhtr "/neovim-tarball-pkg.tar.gz"); then
    echo "|> neovim-TARBALL NOT FOUND. EXITING..."
    return 1
fi
echo "|> FOUND THE SO TARBALL \O/ ...[PASSED]"

EOF


FROM alpine:3.22 AS relay

WORKDIR /app/
COPY --from=builder "/neovim-tarball-pkg.tar.gz" /app

RUN ls -allhtr /app

ENTRYPOINT ["/bin/sh"]
